# One-off data-repair scripts. These bootstrap the Laravel kernel and mutate teacher
# wallets and financial records with no authentication. Anything that needs to run
# repeatedly belongs in app/Console/Commands/ as an artisan command.
/fix_*.php
/payments_resync_fix.php
/example_invoice_form_integration.jsx
/routes.txt
/run-scheduler.bat
/run-gateway.bat

# QA / E2E artifacts: screenshots of admin screens can carry real student names
# and invoice amounts — never let them ride along with a git add -A.
/.playwright-mcp/
/e2e-*.png
/*-page.png
/*-modal.png

/.zcode/

