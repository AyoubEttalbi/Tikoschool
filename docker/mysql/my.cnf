[mysqld]
# === InnoDB Buffer Pool ===
# Increased from 128MB default. On 4GB VPS, give MySQL ~30-35% of RAM.
innodb_buffer_pool_size = 512M
innodb_buffer_pool_instances = 1

# === InnoDB Log ===
innodb_log_file_size = 64M
innodb_log_buffer_size = 16M
# Full durability. This was 2 ("don't fsync the InnoDB log on every commit"), which is a
# real speed/safety trade — except that it bought NOTHING here: sync_binlog defaults to 1
# in MySQL 8, so the binlog was fsynced on every commit anyway. The box paid the per-commit
# latency AND accepted the weaker InnoDB durability, gaining neither.
#
# Now that the binlog is off (see below), the fsync-per-commit is gone with it, so 1 is
# affordable — and this database holds a money ledger.
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT

# === InnoDB I/O ===
# SSD-friendly
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000
innodb_read_io_threads = 4
innodb_write_io_threads = 4

# === Connections ===
# Real peak concurrency is under 15: 5 static php-fpm workers + 1 queue worker + cron +
# the occasional shell. Every allowed connection reserves per-connection buffers
# (sort_buffer + read_buffer + read_rnd_buffer + join_buffer ~= 9 MB), so 50 connections
# was ~450 MB of headroom ON TOP of the 512 MB buffer pool — inside a 1200 MB container
# limit that Docker enforces with SIGKILL, not with backpressure.
max_connections = 20
max_user_connections = 15

# === Thread ===
thread_cache_size = 16
thread_stack = 256K

# === Table Cache ===
# Sized for a few dozen tables, not a few thousand.
table_open_cache = 1000
table_definition_cache = 1000
# table_open_cache_instances exists to shard the cache across CPU cores and reduce mutex
# contention. This VPS has ONE vCPU, so 16 instances only fragmented the budget across
# shards that can never be contended in parallel.
table_open_cache_instances = 1

# === Query Cache (disabled in MySQL 8.0) ===

# === Temp Tables ===
tmp_table_size = 64M
max_heap_table_size = 64M

# === Buffer Sizes ===
sort_buffer_size = 2M
read_buffer_size = 1M
read_rnd_buffer_size = 4M
join_buffer_size = 2M

# === Binary Log ===
# OFF. There is no replica and no point-in-time-recovery tooling anywhere in this repo, so
# the binlog was pure disk I/O and disk space on a 48 GB volume — and its default
# sync_binlog=1 was silently reinstating the per-commit fsync that
# innodb_flush_log_at_trx_commit=2 above had been set to avoid.
#
# If you ever add a replica or real PITR, remove skip-log-bin and pair it with
# innodb_flush_log_at_trx_commit = 1 (already set above) and sync_binlog = 1.
skip-log-bin
log_bin_trust_function_creators = 1

# === Slow Query Log (for debugging) ===
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow-query.log
long_query_time = 2

# === Performance Schema ===
# OFF: it costs a fixed 100-150 MB inside the same 1200 MB container cap, and nothing in
# this deployment reads it. Turn it back ON temporarily when you actually need to profile.
performance_schema = OFF

# === Character Set ===
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci
