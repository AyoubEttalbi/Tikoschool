APP_NAME=TikoSchool
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Use the rotating `daily` channel. `single` writes one unbounded file.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# debug is fine locally; production MUST be `warning` or `error`.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tikoschool
DB_USERNAME=root
DB_PASSWORD=

# redis in production. On `database`, EVERY request — including the 60-second unread-count
# poll that every open tab runs — does a SELECT and an UPDATE against the same MySQL
# instance that holds the wallet ledger. On one vCPU that competes directly with
# money-path queries and InnoDB locks. Redis is already running and already authenticated.
#
# Keep QUEUE_CONNECTION on `database` though: durability matters more there than latency,
# and this Redis has no persistence configured.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# MUST be true in production (the app is HTTPS-only). Leave unset/false for local http.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

# Optional. POSTed to when a money-touching scheduled command fails (wallet:check drift, a
# failed payout run or payout audit). Any endpoint that accepts a POST works —
# Healthchecks.io, Better Stack, Cronitor, or your own webhook.
#
# Failures are logged regardless; this is the channel that reaches a phone. It exists
# because cron runs `schedule:run >> /dev/null 2>&1`, so for a long time wallet:check could
# report ledger drift every night and reach nobody at all.
SCHEDULE_HEARTBEAT_URL=

# How long the dashboard trusts a membership_monthly_stats row before recomputing it.
# 0 recomputes on every dashboard load (the old behaviour).
STATS_CACHE_MINUTES=10

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password reset and every other notification are DEAD with MAIL_MAILER=log —
# the message is only written to storage/logs. Configure a real transport for production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Cloudinary (REQUIRED) -------------------------------------------------
# All profile-image uploads go to Cloudinary. Without these, uploads throw.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Laravel Reverb / websockets (REQUIRED when BROADCAST_CONNECTION=reverb) ---
# The VITE_* copies are read at BUILD time by Vite and are baked into the JS bundle.
# They must be present before `npm run build` or realtime silently fails in the browser.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Comma-separated origin allowlist for the websocket server. Pin this in production.
REVERB_ALLOWED_ORIGINS="*"

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- WhatsApp notifications (WasenderAPI) ----------------------------------
# The webhook fails closed while WASENDERAPI_WEBHOOK_SECRET is empty.
WASENDERAPI_API_KEY=
WASENDERAPI_WEBHOOK_SECRET=
WASENDERAPI_PERSONAL_ACCESS_TOKEN=
