<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
          Pinned so the suite does not depend on whose .env is present. .env.example ships
          fr_FR while most local .env files carry en_US, and Faker formatters are
          locale-specific: SchoolFactory's stateAbbr() exists only in en_US, so the suite was
          green locally and 34 tests failed in CI. Matching .env.example means a locale-only
          formatter now fails on the developer's machine too.
        -->
        <env name="APP_FAKER_LOCALE" value="fr_FR"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
          These MUST stay set. While they were commented out the suite inherited
          DB_CONNECTION/DB_DATABASE from .env and ran against the real working database —
          so any test using RefreshDatabase would have dropped every table in it.

          MySQL rather than sqlite on purpose: this app depends on MySQL-specific behaviour
          (JSON_LENGTH / JSON_CONTAINS / DATE_FORMAT, invoice triggers, and the fact that
          double quotes are string literals without ANSI_QUOTES). Sqlite would silently
          diverge on exactly the queries most worth testing.

          Create the database once:
              CREATE DATABASE tikoschool_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="tikoschool_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
